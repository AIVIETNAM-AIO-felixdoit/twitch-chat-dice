# Copy this file to .env (or set the variables in your shell). Never commit real values.

# Channel the bot joins, without the #
TWITCH_CHANNEL=your_channel_name

# Account the bot chats as (can be your own account)
TWITCH_BOT_USERNAME=your_bot_username

# Chat OAuth token with the chat:read and chat:edit scopes, prefixed with oauth:
# Generate one at https://twitchtokengenerator.com or through the Twitch developer console.
TWITCH_OAUTH_TOKEN=oauth:xxxxxxxxxxxxxxxxxxxx

# Port for the overlay page (optional, default 3000)
OVERLAY_PORT=3000
